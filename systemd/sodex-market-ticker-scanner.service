[Unit]
Description=Anantara Sakti - SoDEX realtime read-only ticker scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/USER/anantara-sakti
ExecStart=/usr/bin/python3 -u /home/USER/anantara-sakti/scripts/sodex_market_ticker_scanner.py --loop --interval 15
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/home/USER/anantara-sakti/logs/sodex_market_ticker_scanner.log
StandardError=append:/home/USER/anantara-sakti/logs/sodex_market_ticker_scanner.log

[Install]
WantedBy=default.target
