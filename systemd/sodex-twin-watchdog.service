[Unit]
Description=Anantara Sakti — SoDEX Twin-Engine Watchdog (24/7)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anashadi
WorkingDirectory=/home/USER/anantara-sakti
EnvironmentFile=/home/USER/anantara-sakti/.env
ExecStart=/bin/bash /home/USER/anantara-sakti/scripts/watchdog_twin.sh
Restart=always
RestartSec=30
StandardOutput=append:/home/USER/anantara-sakti/logs/watchdog.log
StandardError=append:/home/USER/anantara-sakti/logs/watchdog.log

[Install]
WantedBy=multi-user.target
